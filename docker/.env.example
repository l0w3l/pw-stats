HOST_UID=1000
HOST_GID=1000

APP_SERVER_NAME=monya52
APP_XDEBUG=true
APP_VITE_DEV=true
APP_NGINX_HTTP=80
APP_NGINX_HTTPS=8433
APP_ACCESS_TOKEN_PORT=8000
APP_FLAYER_SOLVER_PORT=8191

STORAGE_PREFIX=.
STORAGE_APP=./..
STORAGE_SQLITE="${STORAGE_APP}/database/"
STORAGE_NGINX="${STORAGE_PREFIX}/nginx/storage"
STORAGE_FPM="${STORAGE_PREFIX}/fpm/storage"
STORAGE_POSTGRES="${STORAGE_PREFIX}/postgres/data"

POSTGRES_USER=pixel_world
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=pixel_world_stats

TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_PASSWORD=your_2fa_password
TELEGRAM_SESSION_NAME=session_data/session_name

# Comma-separated Telegram bot usernames accepted by the sidecar (without @).
PIXEL_WORLD_BOT_USERNAME=pixelworld
PIXEL_WORLD_BOT_USERNAME_ALLOWLIST=${PIXEL_WORLD_BOT_USERNAME}
