#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if [[ ! -f .env ]]; then
    printf 'Missing %s/.env; copy docker/.env.example and configure it first.\n' "$SCRIPT_DIR" >&2
    exit 1
fi

# Read one literal dotenv value without evaluating the file as shell code.
dotenv_value() {
    local file=$1 wanted=$2 line key value
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        line=${line#export }
        key=${line%%=*}
        key=${key//[[:space:]]/}
        [[ $key == "$wanted" ]] || continue
        value=${line#*=}
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ ${#value} -ge 2 && (( ${value:0:1} == '"' && ${value: -1} == '"' ) || ( ${value:0:1} == "'" && ${value: -1} == "'" )) ]]; then
            value=${value:1:${#value}-2}
        fi
        printf '%s' "$value"
        return 0
    done < "$file"
    return 1
}

export HOST_UID="$(id -u)"
export HOST_GID="$(id -g)"

ENVIRONMENT=dev
if [[ ${1:-} == dev || ${1:-} == prod ]]; then
    ENVIRONMENT=$1
    shift
fi

STORAGE_APP="$(dotenv_value .env STORAGE_APP || true)"
STORAGE_NGINX="$(dotenv_value .env STORAGE_NGINX || true)"
STORAGE_FPM="$(dotenv_value .env STORAGE_FPM || true)"
STORAGE_POSTGRES="$(dotenv_value .env STORAGE_POSTGRES || true)"
for required_name in STORAGE_APP STORAGE_NGINX STORAGE_FPM STORAGE_POSTGRES; do
    if [[ -z ${!required_name} ]]; then
        printf '%s must be set to a literal path in docker/.env.\n' "$required_name" >&2
        exit 1
    fi
done

APP_ENV_FILE="$STORAGE_APP/.env"
if [[ ! -f $APP_ENV_FILE ]]; then
    printf 'Missing application environment file %s. Copy .env.example there and set APP_KEY.\n' "$APP_ENV_FILE" >&2
    exit 1
fi

APP_NAME="$(dotenv_value "$APP_ENV_FILE" APP_NAME || true)"
PROJECT_NAME="$(printf '%s' "${APP_NAME:-$(basename "$STORAGE_APP")}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-')"
PROJECT_NAME=${PROJECT_NAME#-}
PROJECT_NAME=${PROJECT_NAME%-}
PROJECT_NAME=${PROJECT_NAME:-pixel-world-stats}

compose=(docker compose -p "$PROJECT_NAME" --env-file .env --env-file "$APP_ENV_FILE" -f docker-compose.yml)
if [[ -f docker-compose.$ENVIRONMENT.yml ]]; then
    compose+=(-f "docker-compose.$ENVIRONMENT.yml")
fi

init_storage() {
    local dir file
    printf 'Initializing Docker storage for %s (project: %s)...\n' "$ENVIRONMENT" "$PROJECT_NAME"
    for dir in "$STORAGE_NGINX" "$STORAGE_FPM" "$STORAGE_POSTGRES"; do
        mkdir -p "$dir"
    done
    for file in \
        "$STORAGE_FPM/logs/fpm-php.www.log" \
        "$STORAGE_NGINX/logs/access.log" \
        "$STORAGE_NGINX/logs/error.log"; do
        mkdir -p "$(dirname "$file")"
        touch "$file"
        chmod 664 "$file"
    done
}

command=${1:-}
[[ -n $command ]] && shift || true
case "$command" in
    up|start)
        init_storage
        "${compose[@]}" up -d "$@"
        ;;
    down|stop) "${compose[@]}" down "$@" ;;
    restart) "${compose[@]}" restart "$@" ;;
    build) "${compose[@]}" build "$@" ;;
    logs) "${compose[@]}" logs "$@" ;;
    exec) "${compose[@]}" exec "$@" ;;
    artisan) "${compose[@]}" exec fpm php artisan "$@" ;;
    composer) "${compose[@]}" exec fpm composer "$@" ;;
    tinker) "${compose[@]}" exec fpm php artisan tinker "$@" ;;
    test) "${compose[@]}" exec fpm php artisan test "$@" ;;
    npm)
        if [[ $ENVIRONMENT == dev ]]; then
            npm_service=vite
        else
            npm_service=fpm
        fi
        "${compose[@]}" exec "$npm_service" bash -lc \
            'export NVM_DIR=/var/www/.nvm; source "$NVM_DIR/nvm.sh"; exec npm "$@"' bash "$@"
        ;;
    status) "${compose[@]}" ps "$@" ;;
    '')
        printf 'Usage: ./dc [dev|prod] [up|down|restart|build|logs|exec|artisan|composer|tinker|test|npm|status]\n' >&2
        exit 1
        ;;
    *) "${compose[@]}" "$command" "$@" ;;
esac
