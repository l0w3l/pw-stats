HOST_UID=1000
HOST_GID=1000

APP_XDEBUG=true
APP_VITE_DEV=true
APP_NGINX_HTTP=80
APP_VITE_PORT=5173

STORAGE_APP=./..
STORAGE_NGINX=./nginx/storage
STORAGE_FPM=./fpm/storage
STORAGE_POSTGRES=./postgres/data

POSTGRES_USER=pixel_world
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=pixel_world_stats

TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_PASSWORD=your_2fa_password
TELEGRAM_SESSION_NAME=session_data/session_name

# Must match ACCESS_TOKEN_INTERNAL_SECRET in the application .env. Generate with:
# openssl rand -hex 32
ACCESS_TOKEN_INTERNAL_SECRET=replace_with_a_long_random_secret
# Comma-separated Telegram bot usernames accepted by the sidecar (without @).
PIXEL_WORLD_BOT_USERNAME=pixelworld
PIXEL_WORLD_BOT_USERNAME_ALLOWLIST=${PIXEL_WORLD_BOT_USERNAME}
