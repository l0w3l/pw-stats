APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pixel_world_stats
DB_USERNAME=pixel_world
DB_PASSWORD=change_this_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

ACCESS_TOKEN_BASE_URI=http://access-token:8000/
PIXEL_WORLD_BOT_USERNAME=pixelworld
PIXEL_WORLD_BOT_USERNAME_ALLOWLIST=${PIXEL_WORLD_BOT_USERNAME}

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PIXEL_WORLD_BASE_URI=https://pw.game/api/v2/
PIXEL_WORLD_REQUESTS_PER_MINUTE=120
PIXEL_WORLD_ACCESS_TOKEN_CACHE_TTL_SECONDS=3600
# Set to redis in multi-process production to keep the Bearer token in shared memory.
PIXEL_WORLD_TOKEN_CACHE_STORE=${CACHE_STORE}
PIXEL_WORLD_LEADERBOARD_PAGE_LIMIT=50
PIXEL_WORLD_COLLECTION_LOCK_TTL_SECONDS=7200
PIXEL_WORLD_RECONCILIATION_PASSES=3
PIXEL_WORLD_DAY_COLLECTION_CRON="*/30 * * * *"
PIXEL_WORLD_WEEK_COLLECTION_CRON="17 * * * *"
PIXEL_WORLD_MONTH_COLLECTION_CRON="37 */2 * * *"
PIXEL_WORLD_PLAYER_TOTAL_RAW_RETENTION_DAYS=30
PIXEL_WORLD_PLAYER_TOTAL_HOURLY_RETENTION_DAYS=730
PIXEL_WORLD_PLAYER_TOTAL_RETENTION_HOURS_PER_RUN=24
PIXEL_WORLD_LEADERBOARD_DAY_DETAILED_PERIODS=30
PIXEL_WORLD_LEADERBOARD_WEEK_DETAILED_PERIODS=12
PIXEL_WORLD_LEADERBOARD_MONTH_DETAILED_PERIODS=12
PIXEL_WORLD_LEADERBOARD_ENTRY_RETENTION_CHUNK_SIZE=5000
ANALYTICS_CHART_DAY_PERIODS=30
ANALYTICS_CHART_WEEK_PERIODS=12
ANALYTICS_CHART_MONTH_PERIODS=12
ANALYTICS_CHART_WIDTH=1200
ANALYTICS_CHART_HEIGHT=675
ANALYTICS_CHART_CACHE_RETENTION_HOURS=168
ANALYTICS_CHART_CACHE_VERSION=1
TELEGRAM_WEB_APP_DATA_CACHE_TTL_SECONDS=3600
TELEGRAM_NOTIFICATION_CACHE_STORE=database
TELEGRAM_NOTIFICATION_GLOBAL_PER_SECOND=25
TELEGRAM_NOTIFICATION_SAME_CHAT_INTERVAL_MS=1000
TELEGRAM_NOTIFICATION_BATCH_SIZE=25
TELEGRAM_NOTIFICATION_CLAIM_TTL_SECONDS=180
TELEGRAM_NOTIFICATION_QUEUE=default
TELEGRAM_NOTIFICATION_MAX_ATTEMPTS=5
TELEGRAM_NOTIFICATION_BACKOFF_SECONDS=60,300,900,3600
TELEGRAM_NOTIFICATION_MAX_BACKOFF_SECONDS=3600
TELEGRAM_NOTIFICATION_DEFAULT_RETRY_AFTER_SECONDS=60
TELEGRAM_NOTIFICATION_PERMANENT_FAILURE_POLICY=disable
TELEGRAM_INBOUND_CACHE_STORE=database
TELEGRAM_INBOUND_MAX_ATTEMPTS=10
TELEGRAM_INBOUND_DECAY_SECONDS=60

HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_DELAY_MS=250
HTTP_RETRY_JITTER_MS=250
HTTP_RETRY_MAX_DELAY_SECONDS=30
HTTP_AUTH_LOCK_SECONDS=300
HTTP_AUTH_LOCK_WAIT_SECONDS=300
